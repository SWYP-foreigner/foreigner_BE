<configuration scan="true">
    <!-- 콘솔 JSON -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <!-- 고정 필드 -->
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <stackTrace/>

                <!-- 운영에서 항상 보고 싶은 고정 값 -->
                <globalCustomFields>{"app":"my-service","env":"prod","version":"1.2.3"}</globalCustomFields>

                <!-- 필요한 MDC 키만 선택 포함 -->
                <mdc>
                    <includeMdcKeyName>requestId</includeMdcKeyName>
                    <includeMdcKeyName>userId</includeMdcKeyName>
                    <includeMdcKeyName>uri</includeMdcKeyName>
                    <includeMdcKeyName>method</includeMdcKeyName>
                    <includeMdcKeyName>status</includeMdcKeyName>
                    <includeMdcKeyName>remoteIp</includeMdcKeyName>
                    <includeMdcKeyName>latencyMs</includeMdcKeyName>
                    <includeMdcKeyName>bytesIn</includeMdcKeyName>
                    <includeMdcKeyName>bytesOut</includeMdcKeyName>
                </mdc>

                <!-- 마커(필요 시) -->
                <!-- <logstashMarkers/> -->
            </providers>

            <!-- 마스킹은 유지 -->
            <jsonGeneratorDecorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
                <defaultMask>****</defaultMask>
                <valueMask>
                    <valueRegex>(?i)(Bearer\s+)[A-Za-z0-9._-]+</valueRegex>
                    <replacement>$1****</replacement>
                </valueMask>
                <valueMask>
                    <valueRegex>([A-Za-z0-9._%+-]+)@([A-Za-z0-9.-]+\.[A-Za-z]{2,})</valueRegex>
                    <replacement>$1@****</replacement>
                </valueMask>
            </jsonGeneratorDecorator>
        </encoder>
    </appender>

    <!-- 비동기 -->
    <appender name="ASYNC_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>8192</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>false</includeCallerData>
        <appender-ref ref="CONSOLE_JSON"/>
    </appender>

    <!-- ACCESS / AUDIT 파일도 동일하게 데코레이터 교체 -->
    <!-- ... 동일 패턴으로 수정 ... -->

    <!-- 소음 줄이기 -->
    <logger name="org.hibernate.SQL" level="OFF"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>
    <logger name="org.springframework.web.socket" level="WARN"/>
    <logger name="org.springframework.messaging" level="WARN"/>
    <logger name="org.apache.tomcat.websocket" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="ASYNC_CONSOLE"/>
    </root>
</configuration>
